# Application
APP_NAME=NER Document Analysis Service
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=True

# API
API_HOST=0.0.0.0
API_PORT=8000

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ner-app
KEYCLOAK_CLIENT_ID=ner-backend
KEYCLOAK_CLIENT_SECRET=your-client-secret-here
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=ner-documents
MINIO_SECURE=False

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ner_analysis
MONGODB_COLLECTION_ANALYSES=analyses
MONGODB_COLLECTION_DOCUMENTS=documents

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE_NAME=ner_analysis_queue
RABBITMQ_EXCHANGE=ner_exchange

# LLM Configuration (wybierz jeden)
LLM_PROVIDER=openai  # openai, anthropic, or local
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
LLM_MODEL=gpt-4o-mini  # lub claude-3-5-sonnet-20241022

# NER Model
NER_MODEL_PATH=./models/model1/ner_model_2025_07_13.h5
NER_WORD2IDX_PATH=./models/model1/word2idx_2025_07_13.pkl
NER_IDX2TAG_PATH=./models/model1/idx2tag_2025_07_13.pkl
NER_MAX_LEN=70

# Logging
LOG_LEVEL=INFO
